{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/portfolio_access.log",
            "log_group_name": "/portfolio/api",
            "log_stream_name": "nginx/access/{instance_id}",
            "timestamp_format": "%Y-%m-%d %H:%M:%S",
            "timezone": "UTC",
            "multi_line_start_pattern": "^{.*}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/nginx/portfolio_error.log",
            "log_group_name": "/portfolio/api",
            "log_stream_name": "nginx/error/{instance_id}",
            "timestamp_format": "%Y-%m-%d %H:%M:%S",
            "timezone": "UTC",
            "multi_line_start_pattern": "^{.*}",
            "retention_in_days": 30
          }
        ]
      },
      "systemd": {
        "collect_list": [
          {
            "service_name": "portfolio.service",
            "log_group_name": "/portfolio/api",
            "log_stream_name": "systemd/portfolio/{instance_id}",
            "timestamp_format": "%b %d %H:%M:%S",
            "timezone": "UTC",
            "retention_in_days": 30
          }
        ]
      }
    }
  },
  "metrics": {
    "metrics_collected": {
      "statsd": {
        "service_address": ":8125",
        "metrics_collection_interval": 60,
        "metrics_aggregation_interval": 300
      }
    },
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "ImageId": "${aws:ImageId}",
      "InstanceId": "${aws:InstanceId}"
    }
  }
}
