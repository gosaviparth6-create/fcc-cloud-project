# =============================================================================
# Local Environment Configuration (.env.example)
# =============================================================================
# Copy this template to .env and replace the placeholder values with your
# actual development settings.
# DO NOT commit real secrets or credentials to source control.

# Toggle between AWS SSM Parameter Store (/portfolio/) and local .env
# Set to 'true' in staging/production when using AWS SSM
USE_SSM=false

# Admin Authentication
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Application Security
SECRET_KEY=your_random_secret_key_here
ALLOWED_ORIGIN=http://localhost:3000

# Database Connection (e.g., sqlite:///app.db or postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///app.db

# AWS / Object Storage Configuration
S3_BUCKET=your-portfolio-bucket-name
AWS_REGION=us-east-1

# Upload storage: local for development, s3 for cloud deployments
STORAGE_BACKEND=local

# Server Port
PORT=5000
